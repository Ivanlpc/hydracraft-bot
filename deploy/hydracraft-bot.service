[Unit]
Description=Hydracraft Discord bot (Docker)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStartPre=-/usr/bin/docker rm hydracraft-bot
ExecStart=/usr/bin/docker run --rm --pull=never --name hydracraft-bot --init --network host --read-only --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:rw,noexec,nosuid,size=64m --env-file /etc/hydracraft-bot/.env --mount type=bind,src=/etc/hydracraft-bot/config,dst=/app/config,readonly --mount type=bind,src=/var/lib/hydracraft-bot/logs,dst=/app/logs --mount type=bind,src=/var/lib/hydracraft-bot/charts,dst=/app/charts --stop-timeout 20 hydracraft-bot:latest
ExecStop=/usr/bin/docker stop --time 20 hydracraft-bot
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
